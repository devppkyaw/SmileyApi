{
  "ConnectionStrings": {
    "Default": "Server=localhost\\SQLEXPRESS;Database=SmilrApi;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Hangfire": "Warning",
      "System.Net.Http": "Warning",
      "SmilrApi": "Information"
    }
  },
  "AllowedHosts": "*",
  "BackgroundJobs": {
    "Enabled": true
  },
  "Sync": {
    "MinHoursBetweenRuns": 20
  },
  "Hangfire": {
    "PollIntervalSeconds": 60,
    "WorkerCount": 2
  },
  "ApplicationInsights": {
    "TracesPerSecond": 1.0
  },
  "Seo": {
    "CanonicalOrigin": "https://smilrhq.dk",
    "EnforceCanonicalHost": true
  },
  "Widget": {
    "AllowAnonymousEmbed": true
  },
  "Acs": {
    "ConnectionString": "",
    "SenderAddress": "donotreply@smilrhq.dk"
  },
  "Stripe": {
    "SecretKey": "",
    "WebhookSecret": "",
    "PriceId": ""
  },
  "Email": {
    "OverrideAddress": "",
    "SystemMonitorAddress": ""
  },
  "Admin": {
    "Key": ""
  },
  "FeedHealth": {
    "Enabled": true,
    "StaleAfterHours": 48,
    "RowCountDropPercentThreshold": 20,
    "RequiredFieldDropRateMinimumPercent": 0.5,
    "RequiredFieldDropRateSpikeMultiplier": 3.0,
    "OptionalFieldNullRateJumpPercentagePoints": 10,
    "ReminderIntervalDays": 7
  },
  "Tiers": {
    "ProCvrCap": 20
  }
}
